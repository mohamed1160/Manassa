# =============================================================================
# Manassa Independent Teacher Platform — Public Environment Configuration
# =============================================================================
# Copy this file to `.env` for each independent teacher deployment.
# SECURITY WARNING:
# - NEVER commit a real `.env` file to version control.
# - NEVER place Supabase `service_role` keys or video provider secret keys in `VITE_` variables.

# 1. Supabase Public Credentials (Required for Auth, Database & Storage)
VITE_SUPABASE_URL=https://your-teacher-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# 2. Public Deployment URL & Identity Overrides (Optional; defaults in src/config/site.config.js)
VITE_PUBLIC_SITE_URL=http://localhost:5173
VITE_SITE_NAME=
VITE_TEACHER_NAME=
VITE_SUPPORT_EMAIL=
VITE_WHATSAPP_NUMBER=

# 3. Video Hosting Provider Public Configuration (Optional)
# Supported values: external_signed | bunny | cloudflare | vimeo
VITE_VIDEO_PROVIDER=external_signed
VITE_VIDEO_LIBRARY_ID=
